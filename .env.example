# =============================================================================
# Roundtable Meeting System V1 - Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Moderator LLM Configuration (仲裁者/主持人 独立配置)
# -----------------------------------------------------------------------------
MODERATOR_LLM_NAME=moderator
MODERATOR_LLM_BASE_URL=https://api.lkeap.cloud.tencent.com/coding/v3
MODERATOR_LLM_API_KEY=sk-your-moderator-api-key
MODERATOR_LLM_MODEL=kimi-k2.5
MODERATOR_LLM_TIMEOUT=300

# -----------------------------------------------------------------------------
# Expert LLM Providers (专家 LLM 提供商，按权重轮询分配)
# 可配置多个 Provider，系统根据 WEIGHT 按权重随机选择
# -----------------------------------------------------------------------------

# Provider 1: Tencent Cloud Kimi (腾讯云月之暗面)
LLM_PROVIDER_1_NAME=tencent
LLM_PROVIDER_1_BASE_URL=https://api.lkeap.cloud.tencent.com/coding/v3
LLM_PROVIDER_1_API_KEY=sk-your-tencent-api-key
LLM_PROVIDER_1_MODEL=kimi-k2.5
LLM_PROVIDER_1_WEIGHT=4
LLM_PROVIDER_1_TIMEOUT=300

# Provider 2: Alibaba Qwen (阿里云通义千问)
LLM_PROVIDER_2_NAME=ali_bailian
LLM_PROVIDER_2_BASE_URL=https://coding.dashscope.aliyuncs.com/v1
LLM_PROVIDER_2_API_KEY=sk-your-ali-api-key
LLM_PROVIDER_2_MODEL=glm-5
LLM_PROVIDER_2_WEIGHT=4
LLM_PROVIDER_2_TIMEOUT=300

# 可继续添加更多 Provider:
# LLM_PROVIDER_3_NAME=...
# LLM_PROVIDER_3_BASE_URL=...
# LLM_PROVIDER_3_API_KEY=...
# LLM_PROVIDER_3_MODEL=...
# LLM_PROVIDER_3_WEIGHT=2
# LLM_PROVIDER_3_TIMEOUT=300

# -----------------------------------------------------------------------------
# Web Search (外部搜索，用于自动获取背景信息)
# Option 1: Set SEARCH_API_URL to use a Tavily-compatible local search service
# Option 2: Set TAVILY_API_KEY to use Tavily (free: https://tavily.com, 1000/month)
# If both are set, SEARCH_API_URL takes priority.
# -----------------------------------------------------------------------------
# SEARCH_API_URL=http://192.168.3.89:4001/v1/search
TAVILY_API_KEY=tvly-your-tavily-api-key
